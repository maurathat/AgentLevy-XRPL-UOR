# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
# Choose one. Default to Anthropic per the project plan.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- XRPL testnet wallets (created via faucet in scripts/) ---
# Seeds, NOT addresses. Treat like passwords. Never commit real values.
XRPL_BUYER_SEED=
XRPL_COMPLIANCE_SEED=
XRPL_SANCTIONS_SEED=

# --- XRPL network ---
# Default: Testnet (where standard escrow / EscrowCreate is available).
# WASM Devnet is where XLS-100 Smart Escrow / FinishFunction lands first —
# uncomment that line for Phase 2.8 Path A.
#
# JSON-RPC endpoints (use these with xrpl.clients.JsonRpcClient):
#   Testnet         https://s.altnet.rippletest.net:51234/
#   Devnet          https://s.devnet.rippletest.net:51234/
#   WASM Devnet     https://wasm.devnet.rippletest.net:51234   (XLS-100)
#   Lending Devnet  https://lend.devnet.rippletest.net:51234/
#   Xahau Testnet   https://xahau-test.net/                    (different ledger; not used)
#
# WebSocket endpoints (use these with xrpl.clients.WebsocketClient):
#   Testnet         wss://s.altnet.rippletest.net:51233/
#   Devnet          wss://s.devnet.rippletest.net:51233/
#   WASM Devnet     wss://wasm.devnet.rippletest.net:51233
#   Lending Devnet  wss://lend.devnet.rippletest.net:51233/
#   Xahau Testnet   wss://xahau-test.net/

XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
# XRPL_RPC_URL=https://wasm.devnet.rippletest.net:51234

# --- WASM Devnet (Phase 2.8 Path A: XLS-100 SmartEscrow) ---
# Required for the Smart Escrow demo. WASM Devnet is the only network where
# XLS-100 SmartEscrow is currently activated (rippled 3.2.0-b0).
# These are separate wallets from the Testnet seeds above.
# Faucet: https://faucet.wasm.devnet.rippletest.net/accounts
XRPL_WASM_RPC_URL=https://wasm.devnet.rippletest.net:51234
XRPL_WASM_BUYER_SEED=
XRPL_WASM_COMPLIANCE_SEED=
XRPL_WASM_SANCTIONS_SEED=

# --- Hedera HCS audit-trail anchor (Phase 2.X) ---
# Cert content addresses are submitted to a Hedera Consensus Service (HCS)
# topic for tamper-evident ordering. Settlement stays on XRPL; this is an
# additive second-ledger witness, not a replacement.
#
# Setup: portal.hedera.com → create a testnet account (free; ~3 min) →
# fund from the testnet faucet → copy account ID + DER-encoded private key.
#
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=                  # format: 0.0.NNNNNN
HEDERA_OPERATOR_PRIVATE_KEY=         # DER-encoded hex from portal.hedera.com
HEDERA_HCS_TOPIC_ID=                 # 0.0.NNNNNN — created once via scripts/setup_hcs_topic.py
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Mock mode lets the demo run end-to-end without a live testnet account.
# When MOCK_HEDERA=true, the anchor module returns synthetic HCSReceipt
# values (deterministic from cert content_address) instead of submitting
# to the network. Set false once the testnet credentials above are filled.
MOCK_HEDERA=true

# --- LLM cache mode ---
# "live"  = always call the LLM, write response to fixtures/
# "cache" = read from fixtures/, fail if missing (use this on stage)
LLM_CACHE_MODE=live

# --- Inference pay-per-call demo (Phase 3 / AGI House May 16 2026) ---
# Two-agent demo of x402 inference over XRPL RLUSD with content-addressed
# memoization, model NFT royalty, and dual-MCP integration. See
# agentlevy/inference/ and scripts/run_inference_demo.py.

# Wallets (Testnet seeds, NOT addresses). Generate via faucet, fund with XRP,
# establish RLUSD trust line before running the demo.
XRPL_INFERENCE_AGENT_A_SEED=
XRPL_INFERENCE_AGENT_B_SEED=
XRPL_INFERENCE_SERVER_SEED=
XRPL_INFERENCE_MODEL_OWNER_SEED=

# Ed25519 keypair the server uses to sign DerivationCerts. 64 hex chars (32
# bytes). Distinct from XRPL signing keys. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INFERENCE_SERVER_ED25519_SEED_HEX=

# RLUSD testnet issuer. Read this from Ripple's current docs; the address
# moves as Ripple promotes test deployments. As of 2026-05 the public
# testnet RLUSD issuer is published at https://tryrlusd.com — verify before
# the demo. Establish trust line on every wallet via scripts/setup helpers.
RLUSD_TESTNET_ISSUER=

# Model NFT (XLS-20). Populated by scripts/mint_model_nft.py — do not edit
# by hand. The NFT represents the LLM model's on-chain identity; per-call
# royalties route to MODEL_NFT_OWNER_ADDRESS.
MODEL_NFT_ID=
MODEL_NFT_OWNER_ADDRESS=
MODEL_NFT_METADATA_URI=
MODEL_NFT_NAME=

# Default model the inference server runs. Anthropic model id.
INFERENCE_DEFAULT_MODEL=claude-haiku-4-5

# Whether to dispatch the royalty payment after each inference. Default true.
# Set to false if you want to inspect the primary payment in isolation.
INFERENCE_ROYALTY_ENABLED=true

# Whether to enrich responses with a UOR Foundation MCPS receipt. Adds one
# round-trip to https://mcp.uor.foundation/mcp per inference. Default false
# for hot-path performance; enable for the "live UOR MCP" stage moment.
INFERENCE_USE_LIVE_UOR_MCP=false

# Whether to anchor each cert on Hedera HCS. Honored alongside MOCK_HEDERA
# above. Default true — set MOCK_HEDERA=true to make this safe to run
# without a live Hedera account.
INFERENCE_HCS_ANCHOR_ENABLED=true

# Where the inference server mirrors its cert store for the MCP server
# subprocess to read. Cleared on server restart.
AGENTLEVY_CERT_STORE_PATH=/tmp/agentlevy_certs.json

# Optional: override the UOR Foundation MCP endpoint (for local testing of
# the MCP client against an alternative server). Defaults to the canonical
# Foundation deployment.
# UOR_MCP_URL=https://mcp.uor.foundation/mcp
