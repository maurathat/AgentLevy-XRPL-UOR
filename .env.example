# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
# Choose one. Default to Anthropic per the project plan.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- XRPL testnet wallets (created via faucet in scripts/) ---
# Seeds, NOT addresses. Treat like passwords. Never commit real values.
XRPL_BUYER_SEED=
XRPL_COMPLIANCE_SEED=
XRPL_SANCTIONS_SEED=

# --- XRPL network ---
# Default: Testnet (where standard escrow / EscrowCreate is available).
# WASM Devnet is where XLS-100 Smart Escrow / FinishFunction lands first —
# uncomment that line for Phase 2.8 Path A.
#
# JSON-RPC endpoints (use these with xrpl.clients.JsonRpcClient):
#   Testnet         https://s.altnet.rippletest.net:51234/
#   Devnet          https://s.devnet.rippletest.net:51234/
#   WASM Devnet     https://wasm.devnet.rippletest.net:51234   (XLS-100)
#   Lending Devnet  https://lend.devnet.rippletest.net:51234/
#   Xahau Testnet   https://xahau-test.net/                    (different ledger; not used)
#
# WebSocket endpoints (use these with xrpl.clients.WebsocketClient):
#   Testnet         wss://s.altnet.rippletest.net:51233/
#   Devnet          wss://s.devnet.rippletest.net:51233/
#   WASM Devnet     wss://wasm.devnet.rippletest.net:51233
#   Lending Devnet  wss://lend.devnet.rippletest.net:51233/
#   Xahau Testnet   wss://xahau-test.net/

XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
# XRPL_RPC_URL=https://wasm.devnet.rippletest.net:51234

# --- WASM Devnet (Phase 2.8 Path A: XLS-100 SmartEscrow) ---
# Required for the Smart Escrow demo. WASM Devnet is the only network where
# XLS-100 SmartEscrow is currently activated (rippled 3.2.0-b0).
# These are separate wallets from the Testnet seeds above.
# Faucet: https://faucet.wasm.devnet.rippletest.net/accounts
XRPL_WASM_RPC_URL=https://wasm.devnet.rippletest.net:51234
XRPL_WASM_BUYER_SEED=
XRPL_WASM_COMPLIANCE_SEED=
XRPL_WASM_SANCTIONS_SEED=

# --- Hedera HCS audit-trail anchor (Phase 2.X) ---
# Cert content addresses are submitted to a Hedera Consensus Service (HCS)
# topic for tamper-evident ordering. Settlement stays on XRPL; this is an
# additive second-ledger witness, not a replacement.
#
# Setup: portal.hedera.com → create a testnet account (free; ~3 min) →
# fund from the testnet faucet → copy account ID + DER-encoded private key.
#
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=                  # format: 0.0.NNNNNN
HEDERA_OPERATOR_PRIVATE_KEY=         # DER-encoded hex from portal.hedera.com
HEDERA_HCS_TOPIC_ID=                 # 0.0.NNNNNN — created once via scripts/setup_hcs_topic.py
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Mock mode lets the demo run end-to-end without a live testnet account.
# When MOCK_HEDERA=true, the anchor module returns synthetic HCSReceipt
# values (deterministic from cert content_address) instead of submitting
# to the network. Set false once the testnet credentials above are filled.
MOCK_HEDERA=true

# --- LLM cache mode ---
# "live"  = always call the LLM, write response to fixtures/
# "cache" = read from fixtures/, fail if missing (use this on stage)
LLM_CACHE_MODE=live
